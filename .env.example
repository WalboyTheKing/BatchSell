# BATCHSELL ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure in your deployment environment.
# NOTE: DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.

# Gemini API Key (automatically injected by AI Studio if available)
GEMINI_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"

# Target Network: 56 (BSC Mainnet) or 97 (BSC Testnet)
VITE_DEFAULT_CHAIN_ID="56"

# RPC Endpoints
VITE_BSC_MAINNET_RPC="https://binance.llamarpc.com"
VITE_BSC_TESTNET_RPC="https://data-seed-prebsc-1-s1.binance.org:8545"

# Verified Smart Contract Addresses (BSC Mainnet)
# FourMeme Bonding Curve Router
VITE_FOURMEME_ROUTER_MAINNET="0x5c952063c7fc8610FFDB798152D69F0B9550762b"
# PancakeSwap V2 Router (for graduated tokens)
VITE_PANCAKESWAP_ROUTER_MAINNET="0x10ED43C718714eb63d5aA57B78B54704E256024E"
# BatchSellExecutor Atomic Contract (BSC Mainnet Deployment)
VITE_BATCHSELL_EXECUTOR_MAINNET="0x4B20993Bc481177ec7E8f571ceCaE8A9e22C02db"

# Verified Smart Contract Addresses (BSC Testnet)
VITE_FOURMEME_ROUTER_TESTNET="0x2514897e0F1b05F999D59E71F4259b3B15a81617"
VITE_PANCAKESWAP_ROUTER_TESTNET="0xD99D1c33F9fC3444f8101754aBC46c52416550D1"
VITE_BATCHSELL_EXECUTOR_TESTNET="0x70997970C51812dc3A010C7d01b50e0d17dc79C8"

# Simulation and Security Bounds
# Default slippage tolerance in basis points (200 = 2.0%)
VITE_DEFAULT_SLIPPAGE_BPS="200"
# Maximum acceptable slippage tolerance in basis points (1000 = 10.0%)
VITE_MAX_SLIPPAGE_BPS="1000"
